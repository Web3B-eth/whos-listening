    "tier": "shared"
  },
  {
    "name": "venice as a path",
    "route": {
      "provider": "custom",
      "base_url": "https://proxy.example.com/venice.ai/v1"
    },
    "tier": "shared"
  },
  {
    "name": "localhost",
    "route": {
      "provider": "custom",
