[
  {
    "name": "venice api",
    "route": {
      "provider": "custom",
      "model": "glm-5.3-flash",
      "base_url": "https://api.venice.ai/api/v1"
    },
    "tier": "private"
  },
  {
    "name": "venice subdomain",
    "route": {
      "provider": "custom",
      "base_url": "https://x.venice.ai/v1"
    },
    "tier": "private"
  },
  {
    "name": "lookalike domain",
    "route": {
      "provider": "custom",
      "base_url": "https://notvenice.ai/v1"
