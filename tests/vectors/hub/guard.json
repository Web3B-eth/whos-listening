{
  "about": "A request on its real tier, and what must leave instead. A search query, and any argument of a tool whose role is search, context or list, is blanked to \"\"; other redact_args to [private memory withheld]. sent null means the request leaves unchanged. Tool-call arguments given as JSON text are compared as parsed JSON, not as text. tools is the tools list from hello, and mcp_server the hub's MCP server name in Hermes. All data is made up.",
  "mcp_server": "hub",
  "tools": [
    {"name": "memory_search", "outside_content": false, "redact_args": ["query"], "role": "search"},
    {"name": "memory_save", "outside_content": false, "redact_args": ["text", "reason"], "role": "save"},
    {"name": "memory_forget", "outside_content": false, "redact_args": ["reason"], "role": "forget"},
    {"name": "memory_list", "outside_content": false, "redact_args": ["topic"], "role": "list"}
  ],
  "server_outside_content": false,
