{
  "about": "What the plugin does with each kind of hub answer. answer is {status, body} for a JSON body, {status, raw} for a body sent as-is, {status, headers} for a redirect, {status, size_bytes} for an oversized body, or {timeout: true}. For context, local_layers says whether the plugin's own layers already make the turn shared, and block is the exact text recall adds (\"\" for none). For verdict, keep_seconds is how long the answer is kept, with hello's default verdict_ttl_seconds of 300. All data is made up.",
  "block_header": "Things the user has asked you to remember (Who's Listening). Use them when they help; do not repeat them back unprompted.",
  "cases": [
    {
      "name": "hello: ready, tool names as Hermes spells them",
      "call": "hello",
      "mcp_server": "hub",
      "answer": {"status": 200, "body": {"protocol": 1, "ok": true, "hub": {"name": "Example hub"}, "tools": [
        {"name": "memory_search", "outside_content": false, "redact_args": ["query"]},
        {"name": "memory_save", "outside_content": false, "redact_args": ["text"]}
      ]}},
      "expect": {"ready": true, "tools": ["mcp__hub__memory_search", "mcp__hub__memory_save"], "roles": ["", ""], "save_tool": null, "server_outside_content": true, "verdict_ttl_seconds": 300, "hello_interval_seconds": 3600, "wants_user_messages": false}
    },
    {
      "name": "hello: tool roles name the save tool; an unknown role is ignored",
      "call": "hello",
      "mcp_server": "hub",
      "answer": {"status": 200, "body": {"protocol": 1, "ok": true, "hub": {"name": "Example hub"}, "tools": [
        {"name": "memory_search", "outside_content": false, "redact_args": ["query"], "role": "search"},
        {"name": "memory_save", "outside_content": false, "redact_args": ["text"], "role": "save"},
        {"name": "memory_tidy", "outside_content": false, "redact_args": [], "role": "tidy"}
      ]}},
      "expect": {"ready": true, "tools": ["mcp__hub__memory_search", "mcp__hub__memory_save", "mcp__hub__memory_tidy"], "roles": ["search", "save", ""], "save_tool": "mcp__hub__memory_save"}
    },
    {
      "name": "hello: a role that isn't text is ignored, not a failure",
      "call": "hello",
      "mcp_server": "hub",
      "answer": {"status": 200, "body": {"protocol": 1, "ok": true, "hub": {"name": "Example hub"}, "tools": [
        {"name": "memory_save", "outside_content": false, "redact_args": ["text"], "role": ["save"]},
        {"name": "memory_search", "outside_content": false, "redact_args": ["query"], "role": {"kind": "search"}},
        {"name": "memory_forget", "outside_content": false, "redact_args": ["reason"], "role": 3}
      ]}},
      "expect": {"ready": true, "tools": ["mcp__hub__memory_save", "mcp__hub__memory_search", "mcp__hub__memory_forget"], "roles": ["", "", ""], "save_tool": null}
    },
    {
      "name": "hello: a server name with a hyphen",
